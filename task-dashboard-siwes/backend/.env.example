# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task-dashboard?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:3000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
