# Copy to .env and set your real Supabase values.
# CRA reads only REACT_APP_* variables, so keep this format for compatibility.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Optional: if you still keep local backend for some parts
REACT_APP_API_URL=http://localhost:5000/api
